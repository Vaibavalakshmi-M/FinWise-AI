# FinWise AI Environment Configuration

# Flask Server
FLASK_ENV=development
PORT=5000
SECRET_KEY=finwise_super_secret_jwt_key_hackathon_2026

# Database
DATABASE_PATH=backend/data/finwise.db

# PayPal REST API (Sandbox)
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# AI / LLM Configuration
# Choose provider: 'gemini', 'openai', or 'heuristic'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
